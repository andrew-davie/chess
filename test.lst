      0  1000					      CLEAN_START
      1  1000		       78		      sei
      2  1001		       d8		      cld
      3  1002
      4  1002					      IFNCONST	NO_ILLEGAL_OPCODES
      5  1002		       ab 00		      lxa	#0
      6  1004				  -	      ELSE
      7  1004				  -	      ldx	#0
